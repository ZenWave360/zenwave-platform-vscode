{
  "root": true,
  "parser": "@typescript-eslint/parser",
  "plugins": ["@typescript-eslint"],
  "extends": ["eslint:recommended", "plugin:@typescript-eslint/recommended"],
  "env": {
    "es2022": true
  },
  "parserOptions": {
    "ecmaVersion": 2022,
    "sourceType": "module"
  },
  "ignorePatterns": ["dist/", "node_modules/", "*.mjs"],
  "rules": {
    "@typescript-eslint/no-explicit-any": "error",
    "@typescript-eslint/consistent-type-imports": "warn",
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": ["node:*", "fs", "path", "child_process", "os", "crypto"],
            "message": "Node APIs are only allowed in src/node/. Shared code must run in the Web Worker host too - see AGENTS.md."
          }
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": ["packages/extension/src/node/**/*.ts"],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ]
}
