{
  "name": "zenwave-platform",
  "displayName": "ZenWave Platform",
  "description": "Domain modeling, event storming and API design with ZDL and ZFL.",
  "version": "0.1.0",
  "publisher": "ZenWave360",
  "license": "MIT",
  "icon": "resources/zenwave-logo.png",
  "private": true,
  "homepage": "https://www.zenwave360.io/",
  "bugs": {
    "url": "https://github.com/ZenWave360/zenwave-platform-vscode/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ZenWave360/zenwave-platform-vscode.git"
  },
  "author": {
    "name": "Iván García Sainz-Aja",
    "email": "ivangsa@gmail.com",
    "url": "https://ivangsa.com"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Visualization"
  ],
  "keywords": [
    "ZenWave 360º",
    "ZDL",
    "ZFL",
    "DSL",
    "DDD",
    "Event Storming",
    "Domain Driven Design",
    "API-First"
  ],
  "main": "./dist/node/extension.js",
  "browser": "./dist/browser/extension.js",
  "scripts": {
    "build": "node esbuild.mjs",
    "build:smoke": "node esbuild.mjs --tests",
    "watch": "node esbuild.mjs --watch",
    "package": "node scripts/package.mjs",
    "generate:sdk-catalogue": "node scripts/generate-sdk-catalogue.mjs",
    "verify:vsix": "node scripts/verify-vsix.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test test/unit/*.test.ts",
    "test:desktop": "npm run build && npm run build:smoke && node scripts/run-desktop-smoke.mjs",
    "test:browser": "npm run build && npm run build:smoke && node scripts/run-browser-smoke.mjs",
    "run-in-browser": "npm run build && vscode-test-web --browser=chromium --quality=stable --extensionDevelopmentPath=. fixtures",
    "serve-web": "npm run build && vscode-test-web --browser=none --quality=stable --extensionDevelopmentPath=. fixtures"
  },
  "zenwaveLanguageServer": {
    "package": "@zenwave360/lsp-js",
    "version": "0.1.0-SNAPSHOT"
  },
  "zenwaveEventFlowWebview": {
    "package": "@zenwave360/vistas-eventflow-webview",
    "version": "0.1.0",
    "protocol": "zenwave.eventflow.webview",
    "protocolVersion": 1
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "In Restricted Mode ZenWave starts no language server, resolves no model content and asks for no credentials, and ZenWave SDK code generation is disabled. Syntax highlighting and editing work normally. Trusting the workspace enables the rest without a reload.",
      "restrictedConfigurations": [
        "zenwave.lsp.serverPath",
        "zenwave.workspace.manifest"
      ]
    }
  },
  "activationEvents": [
    "onLanguage:zdl",
    "onLanguage:zfl",
    "workspaceContains:.zenwave/config.yml",
    "onView:zenwave.architecture",
    "onView:zenwave.model"
  ],
  "contributes": {
    "languages": [
      {
        "id": "zdl",
        "aliases": [
          "ZenWave Domain Language",
          "ZDL",
          "zdl"
        ],
        "extensions": [
          ".zdl",
          ".zw"
        ],
        "configuration": "./syntaxes/zdl.language-configuration.json",
        "icon": {
          "light": "./resources/zdl-file-icon.png",
          "dark": "./resources/zdl-file-icon.png"
        }
      },
      {
        "id": "zfl",
        "aliases": [
          "ZenWave Flow Language",
          "ZFL",
          "zfl"
        ],
        "extensions": [
          ".zfl"
        ],
        "configuration": "./syntaxes/zfl.language-configuration.json",
        "icon": {
          "light": "./resources/zenwave-logo.png",
          "dark": "./resources/zenwave-logo.png"
        }
      }
    ],
    "grammars": [
      {
        "language": "zdl",
        "scopeName": "source.zdl",
        "path": "./syntaxes/zdl.tmLanguage.json"
      },
      {
        "language": "zfl",
        "scopeName": "source.zfl",
        "path": "./syntaxes/zfl.tmLanguage.json"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "zenwave",
          "title": "ZenWave",
          "icon": "$(type-hierarchy)"
        }
      ]
    },
    "views": {
      "zenwave": [
        {
          "id": "zenwave.architecture",
          "name": "Architecture",
          "icon": "$(symbol-namespace)",
          "contextualTitle": "ZenWave"
        },
        {
          "id": "zenwave.model",
          "name": "Model",
          "icon": "$(type-hierarchy)",
          "contextualTitle": "ZenWave"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "zenwave.architecture",
        "contents": "Waiting for the ZenWave language server to start...",
        "when": "zenwave.architectureTreeState == loading"
      },
      {
        "view": "zenwave.architecture",
        "contents": "The architecture tree needs the ZenWave language server, which is not available here.\n[Show Language Server Status](command:zenwave.lsp.showStatus)",
        "when": "zenwave.architectureTreeState == no-server"
      },
      {
        "view": "zenwave.architecture",
        "contents": "The connected ZenWave language server does not build hierarchies, so there is no architecture to show.\n[Show Output](command:zenwave.showOutput)",
        "when": "zenwave.architectureTreeState == unsupported"
      },
      {
        "view": "zenwave.architecture",
        "contents": "No architecture manifest was found for this workspace. Name one with `project-manifest` in `.zenwave/config.yml` at a workspace folder root, or with the setting.\n[Configure Architecture Manifest](command:workbench.action.openSettings?%5B%22zenwave.workspace.manifest%22%5D)",
        "when": "zenwave.architectureTreeState == no-manifest"
      },
      {
        "view": "zenwave.architecture",
        "contents": "The ZenWave language server could not read the architecture manifest. A server running in the browser reads only documents open in the editor or served over http(s); open the manifest to browse it here.\n[Open Architecture Manifest](command:zenwave.explorer.openManifest)\n[Show Output](command:zenwave.showOutput)",
        "when": "zenwave.architectureTreeState == not-found"
      },
      {
        "view": "zenwave.architecture",
        "contents": "The architecture manifest could not be read. Its problems are reported in the editor.\n[Open Architecture Manifest](command:zenwave.explorer.openManifest)",
        "when": "zenwave.architectureTreeState == unreadable"
      },
      {
        "view": "zenwave.architecture",
        "contents": "The architecture manifest declares nothing to show yet.\n[Open Architecture Manifest](command:zenwave.explorer.openManifest)",
        "when": "zenwave.architectureTreeState == empty"
      },
      {
        "view": "zenwave.architecture",
        "contents": "The architecture tree could not be loaded. The reason is recorded in the ZenWave output.\n[Show Output](command:zenwave.showOutput)",
        "when": "zenwave.architectureTreeState == failed"
      },
      {
        "view": "zenwave.model",
        "contents": "Waiting for the ZenWave language server to start...",
        "when": "zenwave.modelTreeState == loading"
      },
      {
        "view": "zenwave.model",
        "contents": "The model tree needs the ZenWave language server, which is not available here.\n[Show Language Server Status](command:zenwave.lsp.showStatus)",
        "when": "zenwave.modelTreeState == no-server"
      },
      {
        "view": "zenwave.model",
        "contents": "The connected ZenWave language server does not build hierarchies, so there is no model tree to show.\n[Show Output](command:zenwave.showOutput)",
        "when": "zenwave.modelTreeState == unsupported"
      },
      {
        "view": "zenwave.model",
        "contents": "Open a ZDL or ZFL model to see its hierarchy here.\n[Open a Model](command:workbench.action.quickOpen?%5B%22.z%22%5D)",
        "when": "zenwave.modelTreeState == no-model"
      },
      {
        "view": "zenwave.model",
        "contents": "The model document could not be read. Fix the problems reported for it and the tree follows.\n[Show Problems](command:workbench.actions.view.problems)",
        "when": "zenwave.modelTreeState == unreadable"
      },
      {
        "view": "zenwave.model",
        "contents": "The ZenWave language server could not read this model document.\n[Show Output](command:zenwave.showOutput)",
        "when": "zenwave.modelTreeState == not-found"
      },
      {
        "view": "zenwave.model",
        "contents": "The ZenWave language server reports no hierarchy for this document.",
        "when": "zenwave.modelTreeState == empty"
      },
      {
        "view": "zenwave.model",
        "contents": "The model tree could not be loaded. The reason is recorded in the ZenWave output.\n[Show Output](command:zenwave.showOutput)",
        "when": "zenwave.modelTreeState == failed"
      }
    ],
    "commands": [
      {
        "command": "zenwave.showOutput",
        "title": "Show Output",
        "category": "ZenWave"
      },
      {
        "command": "zenwave.sdk.run",
        "title": "Run SDK Plugin",
        "category": "ZenWave"
      },
      {
        "command": "zenwave.lsp.restart",
        "title": "Restart Language Server",
        "category": "ZenWave"
      },
      {
        "command": "zenwave.lsp.showStatus",
        "title": "Show Language Server Status",
        "category": "ZenWave"
      },
      {
        "command": "zenwave.credentials.record",
        "title": "Record Credential",
        "category": "ZenWave"
      },
      {
        "command": "zenwave.credentials.clear",
        "title": "Clear Stored Credential",
        "category": "ZenWave"
      },
      {
        "command": "zenwave.model.forwardReferences",
        "title": "Go to What This References",
        "category": "ZenWave"
      },
      {
        "command": "zenwave.model.reverseReferences",
        "title": "Go to What References This",
        "category": "ZenWave"
      },
      {
        "command": "zenwave.zfl.organizeServices",
        "title": "Organize ZFL Services",
        "category": "ZenWave"
      },
      {
        "command": "zenwave.explorer.refresh",
        "title": "Refresh",
        "category": "ZenWave",
        "icon": "$(refresh)"
      },
      {
        "command": "zenwave.explorer.openNode",
        "title": "Go to Declaration",
        "category": "ZenWave"
      },
      {
        "command": "zenwave.explorer.openRelated",
        "title": "Open Related Resource...",
        "category": "ZenWave",
        "icon": "$(references)"
      },
      {
        "command": "zenwave.explorer.openManifest",
        "title": "Open Architecture Manifest",
        "category": "ZenWave"
      },
      {
        "command": "zenwave.eventflow.openToSide",
        "title": "Open EventFlow Diagram to the Side",
        "category": "ZenWave",
        "icon": "$(type-hierarchy-sub)"
      },
      {
        "command": "zenwave.eventflow.open",
        "title": "Open EventFlow Diagram",
        "category": "ZenWave",
        "icon": "$(type-hierarchy-sub)"
      },
      {
        "command": "zenwave.eventflow.showText",
        "title": "Show ZFL Text",
        "category": "ZenWave",
        "icon": "$(go-to-file)"
      },
      {
        "command": "zenwave.eventflow.showServiceView",
        "title": "Showing Flow View: Switch to Service View",
        "category": "ZenWave",
        "icon": "$(git-merge)"
      },
      {
        "command": "zenwave.eventflow.showFlowView",
        "title": "Showing Service View: Switch to Flow View",
        "category": "ZenWave",
        "icon": "$(server-process)"
      },
      {
        "command": "zenwave.eventflow.showLabelsAsWritten",
        "title": "Showing Humanized Labels: Show Labels as Written",
        "category": "ZenWave",
        "icon": "$(case-sensitive)"
      },
      {
        "command": "zenwave.eventflow.showHumanizedLabels",
        "title": "Showing Labels as Written: Humanize Labels",
        "category": "ZenWave",
        "icon": "$(symbol-text)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "zenwave.showOutput"
        },
        {
          "command": "zenwave.sdk.run",
          "when": "false"
        },
        {
          "command": "zenwave.lsp.restart"
        },
        {
          "command": "zenwave.lsp.showStatus"
        },
        {
          "command": "zenwave.credentials.record",
          "when": "isWorkspaceTrusted"
        },
        {
          "command": "zenwave.credentials.clear"
        },
        {
          "command": "zenwave.model.forwardReferences",
          "when": "editorLangId =~ /^(zdl|zfl)$/ && zenwave.languageServerAvailable && 'zenwave/symbolAt' in zenwave.languageServerRequests && 'zenwave/forwardReferences' in zenwave.languageServerRequests"
        },
        {
          "command": "zenwave.model.reverseReferences",
          "when": "editorLangId =~ /^(zdl|zfl)$/ && zenwave.languageServerAvailable && 'zenwave/symbolAt' in zenwave.languageServerRequests && 'zenwave/reverseReferences' in zenwave.languageServerRequests"
        },
        {
          "command": "zenwave.zfl.organizeServices",
          "when": "editorLangId == zfl && zenwave.languageServerAvailable && 'zenwave/organizeZflServices' in zenwave.languageServerRequests"
        },
        {
          "command": "zenwave.explorer.refresh",
          "when": "false"
        },
        {
          "command": "zenwave.explorer.openNode",
          "when": "false"
        },
        {
          "command": "zenwave.explorer.openRelated",
          "when": "false"
        },
        {
          "command": "zenwave.explorer.openManifest",
          "when": "zenwave.manifestAvailable"
        },
        {
          "command": "zenwave.eventflow.openToSide",
          "when": "resourceExtname == .zfl && activeCustomEditorId != zenwave.eventflow"
        },
        {
          "command": "zenwave.eventflow.open",
          "when": "resourceExtname == .zfl && activeCustomEditorId != zenwave.eventflow"
        },
        {
          "command": "zenwave.eventflow.showText",
          "when": "activeCustomEditorId == zenwave.eventflow"
        },
        {
          "command": "zenwave.eventflow.showServiceView",
          "when": "activeCustomEditorId == zenwave.eventflow && zenwave.eventflowViewMode == flow"
        },
        {
          "command": "zenwave.eventflow.showFlowView",
          "when": "activeCustomEditorId == zenwave.eventflow && zenwave.eventflowViewMode == services"
        },
        {
          "command": "zenwave.eventflow.showLabelsAsWritten",
          "when": "activeCustomEditorId == zenwave.eventflow && zenwave.eventflowHumanizeLabels"
        },
        {
          "command": "zenwave.eventflow.showHumanizedLabels",
          "when": "activeCustomEditorId == zenwave.eventflow && !zenwave.eventflowHumanizeLabels"
        }
      ],
      "editor/context": [
        {
          "command": "zenwave.model.forwardReferences",
          "when": "editorLangId =~ /^(zdl|zfl)$/ && zenwave.languageServerAvailable && 'zenwave/symbolAt' in zenwave.languageServerRequests && 'zenwave/forwardReferences' in zenwave.languageServerRequests",
          "group": "navigation@90"
        },
        {
          "command": "zenwave.model.reverseReferences",
          "when": "editorLangId =~ /^(zdl|zfl)$/ && zenwave.languageServerAvailable && 'zenwave/symbolAt' in zenwave.languageServerRequests && 'zenwave/reverseReferences' in zenwave.languageServerRequests",
          "group": "navigation@91"
        },
        {
          "command": "zenwave.zfl.organizeServices",
          "when": "editorLangId == zfl && zenwave.languageServerAvailable && 'zenwave/organizeZflServices' in zenwave.languageServerRequests",
          "group": "1_modification@90"
        }
      ],
      "view/title": [
        {
          "command": "zenwave.explorer.refresh",
          "when": "view == zenwave.architecture || view == zenwave.model",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "zenwave.explorer.openRelated",
          "when": "(view == zenwave.architecture || view == zenwave.model) && viewItem =~ /\\.related$/",
          "group": "navigation"
        }
      ],
      "editor/title": [
        {
          "submenu": "zenwave.modelViews",
          "when": "resourceExtname == .zfl",
          "group": "navigation@90"
        },
        {
          "command": "zenwave.eventflow.showServiceView",
          "when": "activeCustomEditorId == zenwave.eventflow && zenwave.eventflowViewMode == flow",
          "group": "navigation@80"
        },
        {
          "command": "zenwave.eventflow.showFlowView",
          "when": "activeCustomEditorId == zenwave.eventflow && zenwave.eventflowViewMode == services",
          "group": "navigation@80"
        },
        {
          "command": "zenwave.eventflow.showLabelsAsWritten",
          "when": "activeCustomEditorId == zenwave.eventflow && zenwave.eventflowHumanizeLabels",
          "group": "navigation@81"
        },
        {
          "command": "zenwave.eventflow.showHumanizedLabels",
          "when": "activeCustomEditorId == zenwave.eventflow && !zenwave.eventflowHumanizeLabels",
          "group": "navigation@81"
        }
      ],
      "zenwave.modelViews": [
        {
          "command": "zenwave.eventflow.openToSide",
          "when": "resourceExtname == .zfl && activeCustomEditorId != zenwave.eventflow",
          "group": "1_eventflow@1"
        },
        {
          "command": "zenwave.eventflow.open",
          "when": "resourceExtname == .zfl && activeCustomEditorId != zenwave.eventflow",
          "group": "1_eventflow@2"
        },
        {
          "command": "zenwave.eventflow.showText",
          "when": "activeCustomEditorId == zenwave.eventflow",
          "group": "0_text@1"
        }
      ]
    },
    "taskDefinitions": [
      {
        "type": "zenwave-sdk",
        "required": [
          "plugin",
          "file"
        ],
        "properties": {
          "plugin": {
            "type": "string",
            "description": "Name of the plugin declared in the model file."
          },
          "file": {
            "type": "string",
            "description": "Model file declaring the plugin, absolute or relative to the workspace folder. The command is assembled from the declaration when the task runs."
          },
          "command": {
            "type": "string",
            "description": "Assembled command line. ZenWave uses this as part of the task identity so only an identical command reuses its terminal."
          }
        }
      }
    ],
    "configuration": {
      "title": "ZenWave Platform",
      "properties": {
        "zenwave.trace.level": {
          "type": "string",
          "enum": [
            "off",
            "info",
            "debug"
          ],
          "default": "info",
          "description": "Verbosity of the ZenWave output channel."
        },
        "zenwave.sdk.cliCommand": {
          "type": "string",
          "default": "jbang zw",
          "scope": "resource",
          "description": "Command used to invoke ZenWave SDK."
        },
        "zenwave.sdk.extraArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "resource",
          "description": "Arguments appended to every ZenWave SDK plugin run, each passed to the SDK as one literal argument."
        },
        "zenwave.sdk.environment": {
          "type": "string",
          "enum": [
            "inherited",
            "loginShell"
          ],
          "enumDescriptions": [
            "Use the environment inherited when VS Code started.",
            "Run through the configured shell with its login profile loaded."
          ],
          "default": "inherited",
          "scope": "resource",
          "description": "Environment used by SDK runs."
        },
        "zenwave.sdk.loginShell": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "Optional shell executable used when zenwave.sdk.environment is loginShell. When empty, ZenWave uses VS Code's preferred terminal shell."
        },
        "zenwave.lsp.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "description": "Start the ZenWave language server for ZDL, ZFL and the architecture manifest. When off, the editor behaves as it does on a host with no server."
        },
        "zenwave.lsp.serverPath": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "description": "Path to a locally built @zenwave360/lsp-js Node entry point (dist/node/zenwave-lsp-server.js) to run instead of the server shipped with the extension. Desktop only; relative paths resolve against the first workspace folder. Run \"ZenWave: Restart Language Server\" after changing it."
        },
        "zenwave.lsp.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "scope": "window",
          "description": "Log the protocol exchange with the ZenWave language server to the ZenWave output channel."
        },
        "zenwave.workspace.manifest": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "The architecture manifest for this workspace, relative to the workspace folder or absolute. When set it is used as-is and nothing is searched for; otherwise project-manifest in .zenwave/config.yml at a workspace folder root is used."
        },
        "zenwave.credentials.origins": {
          "type": "array",
          "scope": "application",
          "markdownDescription": "Origins (`scheme://host[:port]`) the language server may be given a credential for, and how. A credential is released only to an origin listed here, compared exactly. `source` `github` uses your VS Code GitHub sign-in; `stored` uses a secret recorded with **ZenWave: Record Credential** (kept in the OS keychain, never in settings). User settings only.",
          "default": [
            {
              "origin": "https://github.com",
              "source": "github"
            },
            {
              "origin": "https://raw.githubusercontent.com",
              "source": "github"
            },
            {
              "origin": "https://api.github.com",
              "source": "github"
            }
          ],
          "items": {
            "type": "object",
            "required": [
              "origin"
            ],
            "properties": {
              "origin": {
                "type": "string",
                "description": "scheme://host[:port], nothing else."
              },
              "source": {
                "type": "string",
                "enum": [
                  "github",
                  "stored"
                ],
                "default": "stored"
              },
              "type": {
                "type": "string",
                "enum": [
                  "HEADER",
                  "QUERY"
                ],
                "default": "HEADER"
              },
              "key": {
                "type": "string",
                "default": "Authorization",
                "description": "Header or query parameter name."
              },
              "valuePrefix": {
                "type": "string",
                "description": "Text put before the secret, e.g. \"Bearer \". Defaults to \"Bearer \" for GitHub sign-ins in the Authorization header."
              }
            }
          }
        },
        "zenwave.eventflow.defaultView": {
          "type": "string",
          "enum": [
            "flow",
            "services"
          ],
          "enumDescriptions": [
            "The event flow: triggers, commands, events and policies in order.",
            "The service map: commands grouped by the system and service that handle them."
          ],
          "default": "flow",
          "scope": "resource",
          "description": "Which view an EventFlow diagram opens on. Each open diagram can be switched from its title bar afterwards."
        },
        "zenwave.eventflow.humanizeLabels": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Whether an EventFlow diagram opens with humanized labels (CheckoutStarted shown as \"Checkout Started\"). Each open diagram can be switched from its title bar afterwards."
        }
      }
    },
    "customEditors": [
      {
        "viewType": "zenwave.eventflow",
        "displayName": "ZenWave EventFlow Diagram",
        "selector": [
          {
            "filenamePattern": "*.zfl"
          }
        ],
        "priority": "option"
      }
    ],
    "submenus": [
      {
        "id": "zenwave.modelViews",
        "label": "ZenWave: View Model",
        "icon": {
          "light": "./resources/zenwave-preview-light.svg",
          "dark": "./resources/zenwave-preview-dark.svg"
        }
      }
    ]
  },
  "devDependencies": {
    "@types/vscode": "^1.90.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/test-web": "^0.0.81",
    "@vscode/vsce": "^3.0.0",
    "ovsx": "^1.2.0",
    "tsx": "^4.23.13"
  },
  "dependencies": {
    "@zenwave360/dsl": "1.9.0-SNAPSHOT",
    "vscode-languageclient": "9.0.1"
  }
}
