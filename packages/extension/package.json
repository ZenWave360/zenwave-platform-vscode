{
  "name": "zenwave-platform",
  "displayName": "ZenWave Platform",
  "description": "Domain modeling, event storming and API design with ZDL and ZFL.",
  "version": "0.1.0",
  "publisher": "ZenWave360",
  "license": "MIT",
  "icon": "resources/zenwave-logo.png",
  "private": true,
  "homepage": "https://www.zenwave360.io/",
  "bugs": {
    "url": "https://github.com/ZenWave360/zenwave-platform-vscode/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ZenWave360/zenwave-platform-vscode.git"
  },
  "author": {
    "name": "Iván García Sainz-Aja",
    "email": "ivangsa@gmail.com",
    "url": "https://ivangsa.com"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Visualization"
  ],
  "keywords": [
    "ZenWave 360º",
    "ZDL",
    "ZFL",
    "DSL",
    "DDD",
    "Event Storming",
    "Domain Driven Design",
    "API-First"
  ],
  "main": "./dist/node/extension.js",
  "browser": "./dist/browser/extension.js",
  "zenwaveLanguageServer": {
    "package": "@zenwave360/lsp-js",
    "version": "0.1.0-SNAPSHOT"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "In Restricted Mode ZenWave starts no language server, resolves no model content and asks for no credentials, and ZenWave SDK code generation is disabled. Syntax highlighting and editing work normally. Trusting the workspace enables the rest without a reload.",
      "restrictedConfigurations": [
        "zenwave.lsp.serverPath",
        "zenwave.workspace.manifest"
      ]
    }
  },
  "activationEvents": [
    "onLanguage:zdl",
    "onLanguage:zfl",
    "workspaceContains:.zenwave/config.yml"
  ],
  "contributes": {
    "languages": [
      {
        "id": "zdl",
        "aliases": [
          "ZenWave Domain Language",
          "ZDL",
          "zdl"
        ],
        "extensions": [
          ".zdl",
          ".zw"
        ],
        "configuration": "./syntaxes/zdl.language-configuration.json",
        "icon": {
          "light": "./resources/zdl-file-icon.png",
          "dark": "./resources/zdl-file-icon.png"
        }
      },
      {
        "id": "zfl",
        "aliases": [
          "ZenWave Flow Language",
          "ZFL",
          "zfl"
        ],
        "extensions": [
          ".zfl"
        ],
        "configuration": "./syntaxes/zfl.language-configuration.json",
        "icon": {
          "light": "./resources/zenwave-logo.png",
          "dark": "./resources/zenwave-logo.png"
        }
      }
    ],
    "grammars": [
      {
        "language": "zdl",
        "scopeName": "source.zdl",
        "path": "./syntaxes/zdl.tmLanguage.json"
      },
      {
        "language": "zfl",
        "scopeName": "source.zfl",
        "path": "./syntaxes/zfl.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "zenwave.showOutput",
        "title": "Show Output",
        "category": "ZenWave"
      },
      {
        "command": "zenwave.sdk.run",
        "title": "Run SDK Plugin",
        "category": "ZenWave"
      },
      {
        "command": "zenwave.lsp.restart",
        "title": "Restart Language Server",
        "category": "ZenWave"
      },
      {
        "command": "zenwave.lsp.showStatus",
        "title": "Show Language Server Status",
        "category": "ZenWave"
      },
      {
        "command": "zenwave.credentials.record",
        "title": "Record Credential",
        "category": "ZenWave"
      },
      {
        "command": "zenwave.credentials.clear",
        "title": "Clear Stored Credential",
        "category": "ZenWave"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "zenwave.showOutput"
        },
        {
          "command": "zenwave.sdk.run",
          "when": "false"
        },
        {
          "command": "zenwave.lsp.restart"
        },
        {
          "command": "zenwave.lsp.showStatus"
        },
        {
          "command": "zenwave.credentials.record",
          "when": "isWorkspaceTrusted"
        },
        {
          "command": "zenwave.credentials.clear"
        }
      ]
    },
    "taskDefinitions": [
      {
        "type": "zenwave-sdk",
        "required": [
          "plugin",
          "file"
        ],
        "properties": {
          "plugin": {
            "type": "string",
            "description": "Name of the plugin declared in the model file."
          },
          "file": {
            "type": "string",
            "description": "Model file declaring the plugin, absolute or relative to the workspace folder. The command is assembled from the declaration when the task runs."
          }
        }
      }
    ],
    "configuration": {
      "title": "ZenWave Platform",
      "properties": {
        "zenwave.trace.level": {
          "type": "string",
          "enum": [
            "off",
            "info",
            "debug"
          ],
          "default": "info",
          "description": "Verbosity of the ZenWave output channel."
        },
        "zenwave.sdk.cliCommand": {
          "type": "string",
          "default": "jbang zw",
          "scope": "resource",
          "description": "Command used to invoke ZenWave SDK."
        },
        "zenwave.sdk.extraArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "resource",
          "description": "Arguments appended to every ZenWave SDK plugin run, each passed to the SDK as one literal argument."
        },
        "zenwave.sdk.environment": {
          "type": "string",
          "enum": [
            "inherited",
            "loginShell"
          ],
          "enumDescriptions": [
            "Use the environment inherited when VS Code started.",
            "Run through the configured shell with its login profile loaded."
          ],
          "default": "inherited",
          "scope": "resource",
          "description": "Environment used by SDK runs."
        },
        "zenwave.sdk.loginShell": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "Optional shell executable used when zenwave.sdk.environment is loginShell. When empty, ZenWave uses VS Code's preferred terminal shell."
        },
        "zenwave.lsp.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "description": "Start the ZenWave language server for ZDL, ZFL and the architecture manifest. When off, the editor behaves as it does on a host with no server."
        },
        "zenwave.lsp.serverPath": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "description": "Path to a locally built @zenwave360/lsp-js Node entry point (dist/node/zenwave-lsp-server.js) to run instead of the server shipped with the extension. Desktop only; relative paths resolve against the first workspace folder. Run \"ZenWave: Restart Language Server\" after changing it."
        },
        "zenwave.lsp.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "scope": "window",
          "description": "Log the protocol exchange with the ZenWave language server to the ZenWave output channel."
        },
        "zenwave.workspace.manifest": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "The architecture manifest for this workspace, relative to the workspace folder or absolute. When set it is used as-is and nothing is searched for; otherwise project-manifest in .zenwave/config.yml at a workspace folder root is used."
        },
        "zenwave.credentials.origins": {
          "type": "array",
          "scope": "application",
          "markdownDescription": "Origins (`scheme://host[:port]`) the language server may be given a credential for, and how. A credential is released only to an origin listed here, compared exactly. `source` `github` uses your VS Code GitHub sign-in; `stored` uses a secret recorded with **ZenWave: Record Credential** (kept in the OS keychain, never in settings). User settings only.",
          "default": [
            {
              "origin": "https://github.com",
              "source": "github"
            },
            {
              "origin": "https://raw.githubusercontent.com",
              "source": "github"
            },
            {
              "origin": "https://api.github.com",
              "source": "github"
            }
          ],
          "items": {
            "type": "object",
            "required": [
              "origin"
            ],
            "properties": {
              "origin": {
                "type": "string",
                "description": "scheme://host[:port], nothing else."
              },
              "source": {
                "type": "string",
                "enum": [
                  "github",
                  "stored"
                ],
                "default": "stored"
              },
              "type": {
                "type": "string",
                "enum": [
                  "HEADER",
                  "QUERY"
                ],
                "default": "HEADER"
              },
              "key": {
                "type": "string",
                "default": "Authorization",
                "description": "Header or query parameter name."
              },
              "valuePrefix": {
                "type": "string",
                "description": "Text put before the secret, e.g. \"Bearer \". Defaults to \"Bearer \" for GitHub sign-ins in the Authorization header."
              }
            }
          }
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "build:smoke": "node esbuild.mjs --tests",
    "watch": "node esbuild.mjs --watch",
    "package": "node scripts/package.mjs",
    "generate:sdk-catalogue": "node scripts/generate-sdk-catalogue.mjs",
    "verify:vsix": "node scripts/verify-vsix.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test test/unit/*.test.ts",
    "test:desktop": "npm run build && npm run build:smoke && node scripts/run-desktop-smoke.mjs",
    "test:browser": "npm run build && npm run build:smoke && node scripts/run-browser-smoke.mjs",
    "run-in-browser": "npm run build && vscode-test-web --browser=chromium --quality=stable --extensionDevelopmentPath=. fixtures",
    "serve-web": "npm run build && vscode-test-web --browser=none --quality=stable --extensionDevelopmentPath=. fixtures"
  },
  "devDependencies": {
    "@types/vscode": "^1.90.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/test-web": "^0.0.81",
    "@vscode/vsce": "^3.0.0",
    "ovsx": "^1.2.0",
    "tsx": "^4.23.13"
  },
  "dependencies": {
    "@zenwave360/dsl": "1.9.0-SNAPSHOT",
    "vscode-languageclient": "9.0.1"
  }
}
